# Copy to .env locally. Keep all provider credentials blank in shared files.
APP_ENV=development
APP_NAME=AgriShift AI
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DEMO_MODE=false

# Data paths. Real mode never reads FEATURES_EXAMPLE_FILE as a fallback.
FEATURES_FILE=data/features/features.json
FEATURES_EXAMPLE_FILE=data/features/features.example.json
LAYER_DIRECTORY=data/layers
LAYER_METADATA_FILE=data/layers/metadata.json

# Regional NASA POWER history is read from a saved CSV when configured.
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api
NASA_POWER_CSV=
POWER_LIVE_ENABLED=false

# Weather credentials are optional and server-side only.
METEOMATICS_BASE_URL=https://api.meteomatics.com
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=
METEOMATICS_SAMPLE_FILE=

# Hackathon persistence uses SQLite. Never commit the resulting database.
DATABASE_URL=sqlite:///data/agrishift.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Single EXPERT portal account. Generate the hash with:
#   python scripts/hash_expert_password.py
# Use at least 32 random characters for the session signing secret.
EXPERT_EMAIL=
EXPERT_PASSWORD_HASH=
EXPERT_SESSION_SECRET=
